  "cards": [
    {
      "dot": "emerald",
      "title": "线程分界",
      "items": [
        "发送封包在主线程完成，BeginSend 后由 OS 异步负责传输",
        "接收解析（攒包→切包→反序列化）全在线程池线程",
        "派发回到主线程，消息处理器可触碰 Unity API"
      ]
    },
    {
      "dot": "amber",
      "title": "粘包半包对策",
      "items": [
        "包头 14 字节携带总长 PacketLength",
        "蓄水池：长度够了就切，不够就攒",
        "信封 Self-describing：无需两端同步状态"
      ]
    },
    {
      "dot": "violet",
      "title": "RPC 配对",
      "items": [
        "UniqueId 走包头侧信道，绕过 proto 序列化",
        "响应到达先 TryReply 配对，配不上再走 Handler 派发"
      ]
    },
    {
      "dot": "rose",
      "title": "服务器侧",
      "items": [
        "解码同一 14 字节信封（大端对表，两端一致）",
        "处理业务后回发响应，信封回显同一 UniqueId"
      ]
    }
  ]
