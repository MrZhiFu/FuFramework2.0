  "cards": [
    {
      "dot": "violet",
      "title": "配对钥匙",
      "items": [
        "请求方 MessageObject.UniqueId 写进 14 字节信封（侧信道）",
        "服务器回显同一 UniqueId，收包 SetUpdateUniqueId 还原",
        "RpcState 挂起表以 UniqueId 为 key 配对"
      ]
    },
    {
      "dot": "rose",
      "title": "异常必然唤醒",
      "items": [
        "超时：Update 逐帧累计 → TrySetException(Timeout)",
        "断线：Dispose → Cancel → OperationCanceledException",
        "否则 await 会永久悬挂（原实现只 Clear 表）"
      ]
    },
    {
      "dot": "emerald",
      "title": "双通道分流",
      "items": [
        "先 TryReply 配对成功 → 命中 RPC",
        "配不上 → DispatchMessage 走 [MessageHandler]"
      ]
    }
  ]
