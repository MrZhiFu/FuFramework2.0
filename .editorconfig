# 本项目统一编辑器行为约定（Rider / VS Code / Visual Studio 等均遵循此文件）
# 说明：
# - 与项目现状保持一致：文件末尾不保留换行符（Rider/ReSharper 默认行为）。
# - charset 不在此固化：仓库内 UTF-8 BOM 混用（约 1/3 文件带 BOM），固化会引发批量 diff。
# - [*.cs] 节与 Rider 全局层 Code Style 设置保持一致（resharper_* 属性），
#   只收录与 Rider 默认值不同的项；未列出的项跟随 Rider 默认。
# - 命名规则采用 Roslyn 标准格式（dotnet_naming_*），内容与 Rider 全局层命名规则一致
#   （2026-09-24 用户拍板：以后以 Rider 那套为准）。
#   已知近似：[SerializeField] 特征无法在 Roslyn 中识别，私有序列化字段按「私有实例字段」规则匹配；
#   「非 private」用显式可见性列表表达。
root = true

[*]
end_of_line = crlf
insert_final_newline = false

[*.cs]
# 列对齐（ReSharper「Align similar code in columns」全开）
resharper_int_align_assignments = true
resharper_int_align_variables = true
resharper_int_align_fields = true
resharper_int_align_properties = true
resharper_int_align_methods = true
resharper_int_align_invocations = true
resharper_int_align_comments = true
resharper_int_align_binary_expressions = true
resharper_int_align_nested_ternary = true
resharper_int_align_property_patterns = true
resharper_int_align_switch_expressions = true
resharper_int_align_switch_sections = true

# 多行对齐
resharper_align_first_arg_by_paren = true
resharper_align_linq_query = true
resharper_align_tuple_components = true

# 缩进（嵌套语句额外缩进；括号内不使用连续缩进）
resharper_indent_nested_fixed_stmt = true
resharper_indent_nested_for_stmt = true
resharper_indent_nested_foreach_stmt = true
resharper_indent_nested_lock_stmt = true
resharper_indent_nested_usings_stmt = true
resharper_indent_nested_while_stmt = true
resharper_use_continuous_indent_inside_parens = false

# 换行与块
resharper_wrap_limit = 200
resharper_outdent_commas = true
resharper_empty_block_style = together_same_line

# ── 命名规则（Roslyn 标准，与 Rider 全局层命名规则一致；顺序即优先级，先匹配先生效）──
# 仅作用于手写代码目录；Server/ 与 3rdPlugins/ 不受影响。

[Unity/Assets/Scripts/**.cs,Unity/Assets/Editor/**.cs]
# 接口：I 前缀 + PascalCase（IReference、INetworkChannel）
dotnet_naming_rule.interfaces.symbols = interfaces_symbols
dotnet_naming_rule.interfaces.style = i_pascal_case
dotnet_naming_rule.interfaces.severity = warning

dotnet_naming_symbols.interfaces_symbols.applicable_kinds = interface

dotnet_naming_style.i_pascal_case.required_prefix = I
dotnet_naming_style.i_pascal_case.capitalization = pascal_case

# 枚举类型：E 前缀 + PascalCase（EQuality、EUILayer）
dotnet_naming_rule.enum_types.symbols = enum_types_symbols
dotnet_naming_rule.enum_types.style = e_pascal_case
dotnet_naming_rule.enum_types.severity = warning

dotnet_naming_symbols.enum_types_symbols.applicable_kinds = enum

dotnet_naming_style.e_pascal_case.required_prefix = E
dotnet_naming_style.e_pascal_case.capitalization = pascal_case

# 常量（不限可见性）：无前缀 + ALL_CAPS 下划线风格（AA_BB）
dotnet_naming_rule.constants.symbols = constants_symbols
dotnet_naming_rule.constants.style = all_upper_underscore
dotnet_naming_rule.constants.severity = warning

dotnet_naming_symbols.constants_symbols.applicable_kinds = field
dotnet_naming_symbols.constants_symbols.required_modifiers = const

dotnet_naming_style.all_upper_underscore.capitalization = all_upper
dotnet_naming_style.all_upper_underscore.word_separator = _

# 静态只读字段：私有 sr_ + camelCase（sr_gameVersion）；非私有 sr_ + PascalCase（sr_AssetBundle）
dotnet_naming_rule.static_readonly_fields_private.symbols = static_readonly_fields_private_symbols
dotnet_naming_rule.static_readonly_fields_private.style = sr_camel_case
dotnet_naming_rule.static_readonly_fields_private.severity = warning

dotnet_naming_symbols.static_readonly_fields_private_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields_private_symbols.required_modifiers = static, readonly
dotnet_naming_symbols.static_readonly_fields_private_symbols.applicable_accessibilities = private

dotnet_naming_rule.static_readonly_fields.symbols = static_readonly_fields_symbols
dotnet_naming_rule.static_readonly_fields.style = sr_pascal_case
dotnet_naming_rule.static_readonly_fields.severity = warning

dotnet_naming_symbols.static_readonly_fields_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields_symbols.required_modifiers = static, readonly
dotnet_naming_symbols.static_readonly_fields_symbols.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_style.sr_camel_case.required_prefix = sr_
dotnet_naming_style.sr_camel_case.capitalization = camel_case

dotnet_naming_style.sr_pascal_case.required_prefix = sr_
dotnet_naming_style.sr_pascal_case.capitalization = pascal_case

# 静态字段：私有 s_ + camelCase（s_instance）；非私有 s_ + PascalCase（s_Config）
dotnet_naming_rule.static_fields_private.symbols = static_fields_private_symbols
dotnet_naming_rule.static_fields_private.style = s_camel_case
dotnet_naming_rule.static_fields_private.severity = warning

dotnet_naming_symbols.static_fields_private_symbols.applicable_kinds = field
dotnet_naming_symbols.static_fields_private_symbols.required_modifiers = static
dotnet_naming_symbols.static_fields_private_symbols.applicable_accessibilities = private

dotnet_naming_rule.static_fields.symbols = static_fields_symbols
dotnet_naming_rule.static_fields.style = s_pascal_case
dotnet_naming_rule.static_fields.severity = warning

dotnet_naming_symbols.static_fields_symbols.applicable_kinds = field
dotnet_naming_symbols.static_fields_symbols.required_modifiers = static
dotnet_naming_symbols.static_fields_symbols.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_style.s_camel_case.required_prefix = s_
dotnet_naming_style.s_camel_case.capitalization = camel_case

dotnet_naming_style.s_pascal_case.required_prefix = s_
dotnet_naming_style.s_pascal_case.capitalization = pascal_case

# 实例字段（含 readonly / Unity 序列化）：私有 m_ + camelCase（m_fsmDict）；非私有 m_ + PascalCase（m_TableManager）
dotnet_naming_rule.instance_fields_private.symbols = instance_fields_private_symbols
dotnet_naming_rule.instance_fields_private.style = m_camel_case
dotnet_naming_rule.instance_fields_private.severity = warning

dotnet_naming_symbols.instance_fields_private_symbols.applicable_kinds = field
dotnet_naming_symbols.instance_fields_private_symbols.applicable_accessibilities = private

dotnet_naming_rule.instance_fields.symbols = instance_fields_symbols
dotnet_naming_rule.instance_fields.style = m_pascal_case
dotnet_naming_rule.instance_fields.severity = warning

dotnet_naming_symbols.instance_fields_symbols.applicable_kinds = field
dotnet_naming_symbols.instance_fields_symbols.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_style.m_camel_case.required_prefix = m_
dotnet_naming_style.m_camel_case.capitalization = camel_case

dotnet_naming_style.m_pascal_case.required_prefix = m_
dotnet_naming_style.m_pascal_case.capitalization = pascal_case

# 局部变量与参数：camelCase
dotnet_naming_rule.locals.symbols = locals_symbols
dotnet_naming_rule.locals.style = camel_case
dotnet_naming_rule.locals.severity = suggestion

dotnet_naming_symbols.locals_symbols.applicable_kinds = local,parameter

dotnet_naming_style.camel_case.capitalization = camel_case

# ── 生成代码豁免（Luban 表 / FGUI Gen / Proto / AOT 本地化）──
[Unity/Assets/Scripts/Hotfix/Game/AutoGen/**.cs,Unity/Assets/Scripts/AOT/Launch/Localization/AutoGen/**.cs]
dotnet_naming_rule.interfaces.severity = none
dotnet_naming_rule.enum_types.severity = none
dotnet_naming_rule.constants.severity = none
dotnet_naming_rule.static_readonly_fields_private.severity = none
dotnet_naming_rule.static_readonly_fields.severity = none
dotnet_naming_rule.static_fields_private.severity = none
dotnet_naming_rule.static_fields.severity = none
dotnet_naming_rule.instance_fields_private.severity = none
dotnet_naming_rule.instance_fields.severity = none
dotnet_naming_rule.locals.severity = none
