using System;
using System.Collections.Generic;
using Luban;
using Hotfix.Framework.Config;
using Cysharp.Threading.Tasks;

// ReSharper disable once CheckNamespace
{{namespace_with_grace_begin __namespace}}
    public partial class {{__name}}
    {
        {{~for table in __tables ~}}
        {{~if table.comment != '' ~}}
        /// <summary> {{escape_comment table.comment}} </summary>
        {{~else~}}
        /// <summary> {{table.name}} </summary>
        {{~end~}}
        private {{table.name}} {{format_property_name __code_style table.name}} { set; get; }

        {{~end~}}

        /// <summary> 是否加载完成 </summary>
        public bool IsLoaded { private set; get; }

        /// <summary> 框架配置模块 </summary>
        private ConfigModule m_ConfigModule;


        /// <summary>
        /// 初始化表管理器（关联配置模块并清空已有配置）
        /// </summary>
        /// <param name="configModule">配置管理模块</param>
        public void Init(ConfigModule configModule)
        {
            m_ConfigModule = configModule;
            m_ConfigModule.RemoveAllConfigs();
        }

        /// <summary>
        /// 异步加载全部配置表
        /// </summary>
        /// <param name="loader">取配置表 ByteBuf 的加载委托</param>
        /// <returns>全部表加载完成</returns>
        /// <remarks>逐表建立、并行 await，全部完成后刷新引用</remarks>
        public async UniTask LoadAsync(Func<string, UniTask<ByteBuf>> loader)
        {
            if (IsLoaded) return;

            IsLoaded = false;
            m_ConfigModule.RemoveAllConfigs();
            var loadTasks = new List<UniTask>();

            {{~for table in __tables ~}}
            {{format_property_name __code_style table.name}} = new {{table.name}}(() => loader("{{table.output_data_file}}"));
            loadTasks.Add({{format_property_name __code_style table.name}}.LoadAsync());
            m_ConfigModule.AddConfig(nameof({{table.name}}), {{format_property_name __code_style table.name}});

            {{~end~}}
            await UniTask.WhenAll(loadTasks);

            OnInit();
            ResolveRef();

            IsLoaded = true;
        }

        /// <summary>
        /// 解析所有配置表的跨表引用（表之间已加载完毕）
        /// </summary>
        private void ResolveRef()
        {
            {{~for table in __tables ~}}
            {{format_property_name __code_style table.name}}.ResolveRef(this);
            {{~end~}}
            PostResolveRef();
        }

        /// <summary>
        /// 为所有配置表设置本地化翻译器
        /// </summary>
        /// <param name="translator">翻译委托：传入 (key, original) 返回译文</param>
        /// <exception cref="InvalidOperationException">如果未加载完成将抛出此异常</exception>
        public void SetTranslateText(Func<string, string, string> translator)
        {
            if (IsLoaded == false) throw new InvalidOperationException("为配置表设置本地化翻译器失败，配置表没有被加载!");

            {{~for table in __tables ~}}
            {{format_property_name __code_style table.name}}.TranslateText(translator);
            {{~end~}}
        }

        /// <summary>
        /// 分部初始化钩子，由使用方补实现。
        /// 典型场景：完成一些所有配置表加载完成后的自定义预处理收尾工作
        /// </summary>
        partial void OnInit();
        /// <summary>
        /// 分部钩子，所有跨表引用解析完成后调用
        /// </summary>
        partial void PostResolveRef();
    }
{{namespace_with_grace_end __namespace}}