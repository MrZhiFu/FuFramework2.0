{{~
    comment = __enum.comment
    items = __enum.items
~}}
// ReSharper disable once CheckNamespace
{{namespace_with_grace_begin __top_module}} 
{{~if comment != '' ~}}
    /// <summary>
    /// {{escape_comment comment}}
    /// </summary>
{{~end~}}
    {{~if __enum.is_flags~}}
    [System.Flags]
    {{~end~}}
    public enum {{__name}}
    {
        {{~ for item in items ~}}
{{~if for.index > 0 ~}}

{{~end~}}
{{~if item.comment != '' ~}}
        /// <summary> {{escape_comment item.comment_or_alias}} </summary>
{{~end~}}
        {{format_enum_item_name __code_style item.name}} = {{item.value}},
        {{~end~}}
    }
{{namespace_with_grace_end __top_module}}