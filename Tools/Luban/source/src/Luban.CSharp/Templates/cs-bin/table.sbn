        /// </summary>
        /// <param name="loadFunc">取配置表 ByteBuf 的加载委托</param>
        public {{__name}}(Func<UniTask<ByteBuf>> loadFunc) => m_LoadFunc = loadFunc;

        /// <summary>
        /// 异步加载本表数据
        /// </summary>
        /// <remarks>从 loader 取 ByteBuf、逐条反序列化，完成后调用 PostInit</remarks>
        public async UniTask LoadAsync()
        {
            var buf = await m_LoadFunc();

            int n = buf.ReadSize();
            if (n != 1) throw new SerializationException("table mode=one, but size != 1");
            _data = {{value_simple_name}}.Deserialize{{value_simple_name}}(buf);
            OnInit();
        }

