        {{~else if !__table.index_list.empty?~}}
        {{~for idx in __table.index_list~}}
        private Dictionary<{{declaring_type_name idx.type}}, {{value_simple_name}}> _dataMap_{{idx.index_field.name}};
        {{~end~}}
        {{~end~}}

        /// <summary>
        /// 取配置表 ByteBuf 的加载委托（由 TableManager 注入，参数为表文件路径）
