        public {{value_simple_name}} GetBy{{format_property_name __code_style idx.index_field.name}}({{declaring_type_name idx.type}} key) => _dataMap_{{idx.index_field.name}}.TryGetValue(key, out {{value_simple_name}} __v) ? __v : null;
        {{~end~}}
        {{~end~}}

