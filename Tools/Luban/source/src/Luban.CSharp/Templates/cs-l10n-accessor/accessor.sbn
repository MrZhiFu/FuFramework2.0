{{namespace_with_grace_begin __namespace}}
    /// <summary>
    /// 本地化取词访问器（配置生成，禁止手改）。
    ///     GetText 的语言分支由本地化表语言列 + LanguageDef 生成：删/增语种（Excel 删列）时 case 自动增减，
    ///     default 回落兜底语种列——运行时取词零手写语言分支。
    ///     与拆分产物契约配套：每个语种文件只含 key + 目标语种列，其余语种列为空串；
    ///     目标语种缺失（未翻译）时由 Provider 二段查询兜底语种表。
    /// </summary>
    public static class {{__class_name}}
    {
        /// <summary>
        /// 取指定语言的文本
        /// </summary>
        /// <param name="row">本地化表行</param>
        /// <param name="language">目标语言</param>
        /// <returns>该语言的文本；行/语言未知时回落兜底语种列</returns>
        public static string GetText({{__row_type}} row, ELanguage language)
        {
            if (row == null) return string.Empty;
            switch (language)
            {
                // @formatter:off
{{~for f in __fields~}}
                case ELanguage.{{f.name}}: return row.{{f.property}};
{{~end~}}
                // @formatter:on
                default: return row.{{__fallback_property}}; // 语言类型未支持时，统一使用兜底语种列
            }
        }

        /// <summary>
        /// 兜底语种名（与 LanguageDef is_fallback 行一致）
        /// </summary>
        public const string FallbackName = "{{__fallback_name}}";
    }
{{namespace_with_grace_end __namespace}}
