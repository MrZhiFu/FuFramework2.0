using System;
{{namespace_with_grace_begin __namespace}}
    /// <summary>
    /// 语言注册表（配置生成，禁止手改）。
    ///     数据源：Config/Excels/Tables/L-LanguageDef-c-语言定义.xlsx。
    ///     删除/新增语种只改配置数据（LanguageDef 行 + 本地化表语言列 + ELanguage 枚举成员），本类随生成自动更新。
    ///     文件名后缀 / YooAsset 资源标签 / 偏好存储名一律使用 Name（ELanguage 枚举成员名）。
    /// </summary>
    public static class {{__class_name}}
    {
        /// <summary>
        /// 语言条目
        /// </summary>
        public sealed class Entry
        {
            /// <summary>语言枚举</summary>
            public readonly ELanguage Language;
            /// <summary>语言枚举成员名（文件后缀 / 资源标签 / 偏好存储名）</summary>
            public readonly string Name;
            /// <summary>显示名</summary>
            public readonly string DisplayName;
            /// <summary>排序</summary>
            public readonly int Sort;
            /// <summary>逗号分隔符</summary>
            public readonly string Separator;
            public Entry(ELanguage language, string name, string displayName, int sort, string separator)
            {
                Language = language;
                Name = name;
                DisplayName = displayName;
                Sort = sort;
                Separator = separator;
            }
        }

        /// <summary>
        /// 全部语言条目（按 sort 升序）
        /// </summary>
        public static readonly Entry[] Entries = new Entry[]
        {
{{~for e in __entries~}}
            new Entry(ELanguage.{{e.name}}, "{{e.name}}", "{{escape_string e.display_name}}", {{e.sort}}, "{{escape_string e.separator}}"),
{{~end~}}
        };

        /// <summary>
        /// 兜底语种（业务不变量：英语兜底，固定 English，不做配置）
        /// </summary>
        public static readonly Entry Fallback = Entries[FallbackIndex];

        /// <summary>
        /// 兜底语种在 Entries 中的下标
        /// </summary>
        private const int FallbackIndex = {{__fallback_index}};

        /// <summary>
        /// 兜底语种名（拆分文件后缀 / 资源标签）
        /// </summary>
        public const string FallbackName = "English";

        /// <summary>
        /// 按语言枚举查条目
        /// </summary>
        public static bool TryGet(ELanguage language, out Entry entry)
        {
            for (int i = 0; i < Entries.Length; i++)
            {
                if (Entries[i].Language == language)
                {
                    entry = Entries[i];
                    return true;
                }
            }
            entry = null;
            return false;
        }

        /// <summary>
        /// 按语言枚举成员名查条目（偏好字符串校验用，大小写不敏感与 Enum.TryParse 行为对齐）
        /// </summary>
        public static bool TryGetByName(string name, out ELanguage language)
        {
            for (int i = 0; i < Entries.Length; i++)
            {
                if (string.Equals(Entries[i].Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    language = Entries[i].Language;
                    return true;
                }
            }
            language = ELanguage.Unspecified;
            return false;
        }

        /// <summary>
        /// Unity 系统语言 → 语言枚举（映射由 system_language 列生成；未覆盖的系统语言回落兜底语种）
        /// </summary>
        // 由模板按数据静态生成 switch，default 兜底，无需运行时查找
        public static ELanguage FromSystemLanguage(UnityEngine.SystemLanguage systemLanguage)
        {
            switch (systemLanguage)
            {
{{~for e in __entries~}}{{~for sys in e.system_languages~}}
                case UnityEngine.SystemLanguage.{{sys}}: return ELanguage.{{e.name}};
{{~end~}}{{~end~}}
                default: return ELanguage.English;
            }
        }
    }
{{namespace_with_grace_end __namespace}}
